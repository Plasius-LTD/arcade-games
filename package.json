  "name": "@plasius/arcade-games",
  "version": "0.1.0",
  "description": "Lazy original spatial arcade catalogue and versioned content contracts",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
