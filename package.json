  "scripts": {
    "build": "node scripts/build-package.mjs",
    "test": "vitest run && npm run test:privacy",
    "test:watch": "vitest",
    "test:privacy": "node --experimental-test-coverage --test-coverage-include=scripts/private-artifact-policy.cjs --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=.privacy-lcov.info --test tests/private-artifact-policy.test.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "audit:eslint": "npm run lint",
    "audit:npm": "npm audit --audit-level=high --omit=dev",
    "test:coverage": "vitest run --coverage && npm run test:privacy && node -e \"const fs = require('node:fs'); fs.appendFileSync('coverage/lcov.info', fs.readFileSync('.privacy-lcov.info'));\"",
    "audit:test": "npm run test:coverage",
    "privacy:check": "node scripts/verify-private-artifacts.cjs",
    "pack:check": "npm run privacy:check && node scripts/verify-public-package.cjs",
    "prepublishOnly": "npm run build && npm run pack:check"
  },
  "keywords": [
    "plasius",
    "arcade",
    "games",
    "catalogue",
    "typescript"
  ],
  "author": "Plasius LTD <development@plasius.co.uk>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
